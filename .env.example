# Copy to `.env`. Both keys are required; `.env` is gitignored.

# The API. Staging shown; production has its own host.
BASE_URL=https://api.staging.gospeltube.tv

# The public CloudFront distribution that serves content assets.
#
# Feed rows for posts, events, devotional series, media series and creator
# avatars carry a bare storage key ("public/thumbnail/{creatorId}/{file}")
# rather than a URL — the key is the path of an object on this host. Without
# this, every non-media card renders with no artwork.
#
# Environment-specific: production must set its own. An unset value degrades
# to no artwork rather than pointing production at staging's bucket.
CDN_BASE_URL=https://d17puiamcqzhr0.cloudfront.net

# ---- Signing in with Google ------------------------------------------------
# Neither value is a secret: an OAuth client id ships inside every copy of
# every app that uses it. They are here because they are per environment —
# staging and production are separate Google projects — and because a build
# with the wrong one fails verification at the gateway rather than anywhere a
# person could understand.
#
# Leave either blank and the Google button is simply not drawn. That is the
# intended failure mode: a button that opens a sheet which cannot succeed is
# worse than no button.

# The WEB OAuth client id, passed to the SDK as the server client id on both
# platforms. It is what sets the `aud` claim of the id token, and the gateway
# accepts the web client as an audience with nothing added to its
# GOOGLE_OAUTH_NATIVE_CLIENT_IDS. This is the same value the web auth app
# publishes as NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_SERVER_CLIENT_ID=539827848864-h0u0mun51rh08f34vsb0s35g94fn4bto.apps.googleusercontent.com

# The iOS OAuth client id, for the iOS build only. Android identifies itself
# by package name plus signing-certificate SHA-1 against the Android client
# registered in the same Google project, and carries no client id at all.
#
# Setting this is only half of iOS: the reversed form of the same id has to go
# into ios/Flutter/Social.xcconfig, which is what Google redirects back to.
#
# It must be an iOS client in the SAME Google project as the web client above
# (539827848864). The SDK asks Google for a token audienced to that web
# client, and Google will not issue one across unrelated projects.
GOOGLE_IOS_CLIENT_ID=539827848864-96e9oc4aefoh412ru6a3tdhuv5pqhuhd.apps.googleusercontent.com
